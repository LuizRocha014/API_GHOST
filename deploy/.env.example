# Copie para .env (o .env NÃO vai para o git) e preencha. Use senhas novas, longas e aleatórias.

# Domínio apontado (registro A) para o IP do servidor. O Caddy pede o certificado HTTPS sozinho.
DOMINIO=agenda.suaestetica.com.br

# Senha do usuário sa do SQL Server: 12+ caracteres com maiúscula, minúscula, número e símbolo.
SQL_SENHA=

# Chave que assina os logins (JWT): 64 caracteres aleatórios. Trocar desloga todo mundo.
# PowerShell: -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 64 | % {[char]$_})
JWT_CHAVE=

# Nome da empresa e da filial criadas no primeiro start (banco vazio).
EMPRESA=Minha estética
FILIAL=Matriz

# WhatsApp: Log = não envia nada (testes). Cloud = envia pela WhatsApp Cloud API (depois de criar a conta na Meta).
WHATSAPP_MODO=Log
WHATSAPP_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Id da filial (aparece no log da API ao subir e em Ajustes › Equipe no app).
WHATSAPP_FILIAL_ID=
